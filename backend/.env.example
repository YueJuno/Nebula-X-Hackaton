APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SIGNUP_CODE=REPLACE_WITH_A_PRIVATE_SIGNUP_CODE
FRONTEND_ORIGIN=http://localhost:5173
SOLVER_TIME_LIMIT_SECONDS=60
# Optional JSON array. The executable should print a JSON report containing
# a boolean `feasible` field.
# VALIDATOR_COMMAND=["python","path/to/validator.py","{instance_dir}","{submission_dir}"]
